# ========================================
# Medusa Automation — .gitignore
# ========================================

# Maven build output
target/

# IntelliJ IDEA
.idea/
*.iml
*.iws
out/

# Eclipse
.project
.classpath
.settings/

# VS Code
.vscode/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Credentials — KHÔNG BAO GIỜ commit file này
config/test.properties

# Logs
*.log
chromedriver.log
geckodriver.log

# Allure local cache
.allure/

# Reports (sinh ra khi chạy test)
allure-results/
allure-report/
test-output/

# Screenshots (sinh ra khi test fail)
target/screenshots/

# Excel temp lock files
~$*.xlsx
~$*.xls

# Environment files
.env
.env.local
